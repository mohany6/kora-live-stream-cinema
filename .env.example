# Backend
LIVE_SCORE_DB_PATH=data/live_score.db
LIVE_SCORE_ADMIN_TOKEN=change-me-in-production
LIVE_SCORE_TIMEZONE=Asia/Riyadh

# Hosted livescoreFootball public API (no API key required).
# Defaults to ESPN primary with worldcup26.ir secondary.
# Set a custom URL to prioritize it, or set "demo" for offline data.
LIVE_SCORE_API_URL=

# Optional streaming portal URL for automated live stream scraping (e.g., https://kora-portal.example)
LIVE_SCORE_SCRAPER_URL=

# Optional comma-separated upstream league catalog (18 leagues by default):
# eng.1,eng.2,esp.1,esp.2,ita.1,ger.1,fra.1,ned.1,por.1,sco.1,bel.1,tur.1,ksa.1,usa.1,mex.1,arg.1,bra.1,jpn.1
LIVE_SCORE_LEAGUES=

# Persist the last good live slate so restarts survive upstream outages.
LIVE_SCORE_SNAPSHOT=on
LIVE_SCORE_SNAPSHOT_PATH=data/live_fixtures_snapshot.json
LIVE_SCORE_SNAPSHOT_MAX_AGE_HOURS=36

LIVE_SCORE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (create frontend/.env.local to override)
VITE_API_BASE_URL=http://127.0.0.1:8000
