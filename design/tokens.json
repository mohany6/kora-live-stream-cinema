{
  "$schema": "https://design-tokens.org/schema.json",
  "meta": {
    "name": "Kora RTL Football Platform",
    "version": "1.0.0",
    "direction": "rtl",
    "defaultMode": "dark",
    "description": "RTL-first design tokens shared by Figma and the Tailwind frontend."
  },
  "colors": {
    "status": {
      "live-red": "#dc2626",
      "live-red-soft": "#dc262629",
      "countdown-green": "#16a34a",
      "countdown-green-soft": "#16a34a29",
      "pitch-green": "#15803d",
      "pitch-green-deep": "#14532d",
      "finished-neutral": "#64748b",
      "postponed-amber": "#d97706"
    },
    "brand": {
      "primary": "#0ea5e9",
      "primary-hover": "#0284c7",
      "primary-soft": "#0ea5e91f",
      "accent": "#f59e0b"
    },
    "light": {
      "background": "#f8fafc",
      "surface": "#ffffff",
      "surface-raised": "#f1f5f9",
      "text": "#0f172a",
      "text-muted": "#475569",
      "border": "#e2e8f0"
    },
    "dark": {
      "background": "#0b1120",
      "surface": "#111c31",
      "surface-raised": "#1e293b",
      "text": "#f8fafc",
      "text-muted": "#94a3b8",
      "border": "#26344a"
    }
  },
  "spacing": {
    "unit": "4px",
    "scale": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "20": "80px"
    }
  },
  "rtl": {
    "direction": "rtl",
    "textAlign": "start",
    "logicalProperties": [
      "margin-inline-start",
      "margin-inline-end",
      "padding-inline-start",
      "padding-inline-end",
      "border-inline-start",
      "border-inline-end",
      "inset-inline-start",
      "inset-inline-end"
    ],
    "notes": "Use logical properties only; home team renders at inline-start (right in RTL)."
  },
  "radius": {
    "sm": "6px",
    "md": "10px",
    "lg": "16px",
    "xl": "24px",
    "pill": "999px"
  },
  "typography": {
    "fontFamily": {
      "arabic": "\"Cairo\", \"Tajawal\", \"Noto Kufi Arabic\", sans-serif",
      "latin": "\"Inter\", system-ui, -apple-system, sans-serif",
      "numbers": "\"Inter\", \"Cairo\", sans-serif"
    },
    "fontSize": {
      "xs": "12px",
      "sm": "14px",
      "base": "16px",
      "lg": "18px",
      "xl": "22px",
      "2xl": "28px",
      "3xl": "36px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "lineHeight": {
      "tight": 1.2,
      "normal": 1.5,
      "relaxed": 1.75
    }
  },
  "shadows": {
    "card": "0 10px 30px -18px rgba(2, 6, 23, 0.45)",
    "card-hover": "0 18px 45px -20px rgba(2, 6, 23, 0.55)",
    "player": "0 18px 50px -24px rgba(2, 6, 23, 0.65)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "220ms",
      "slow": "400ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "livePulse": {
      "duration": "1.6s",
      "iteration": "infinite",
      "easing": "cubic-bezier(0.4, 0, 0.6, 1)"
    }
  },
  "components": {
    "matchCard": {
      "minHeight": "92px",
      "crestSize": "44px",
      "padding": "12px 16px",
      "gap": "16px",
      "liveBadgePulse": "livePulse"
    },
    "scheduleTabs": {
      "height": "40px",
      "pillRadius": "pill",
      "activeBackground": "brand.primary",
      "inactiveBackground": "surface-raised"
    },
    "streamPlayer": {
      "aspectRatio": "16 / 9",
      "serverPillRadius": "pill",
      "serverPillHeight": "36px",
      "iframeSandbox": "allow-scripts allow-same-origin allow-presentation"
    },
    "pitch": {
      "aspectRatio": "68 / 105",
      "lineColor": "rgba(255, 255, 255, 0.55)",
      "playerChipSize": "34px",
      "formationGap": "8px"
    },
    "timeline": {
      "iconSize": "28px",
      "rowGap": "10px"
    },
    "stats": {
      "barHeight": "8px",
      "barRadius": "pill",
      "homeColor": "brand.primary",
      "awayColor": "status.finished-neutral"
    }
  }
}
