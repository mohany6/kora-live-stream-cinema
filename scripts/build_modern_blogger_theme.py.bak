def build_preview_html():
    """Assemble the ultra-modern standalone HTML preview."""
    hero = MATCHES_DATA[0]
    
    html = f"""<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>كورة لايف PRO | مباريات اليوم وبث مباشر القنوات الناقلة</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800;900&family=Chakra+Petch:wght@700;900&display=swap" rel="stylesheet">
  <style>
{CSS_STYLES}
  </style>
</head>
<body>

  <!-- Top Real-time Bar -->
  <div class="ticker-bar">
    <div class="ticker-content">
      <span class="live-pulse-badge"><span class="pulse-dot"></span> مباريات اليوم مباشرة</span>
      <span class="ticker-text">قمة دوري أبطال أوروبا الليلة: أرسنال ضد دورتموند • مانشستر سيتي ضد نابولي • ريال مدريد ضد PSV</span>
    </div>
    <div class="ticker-time">
      <span>تحديث حي</span>
      <span id="liveClock">23:00 UTC+3</span>
    </div>
  </div>

  <!-- Main Navigation -->
  <header class="navbar">
    <div class="nav-container">
      <a href="#" class="brand-wrap">
        <div class="brand-crest">
          {SVG_ICONS['ball']}
        </div>
        <div class="brand-title">
          كورة<span>لايف</span>
          <span class="pro-pill">PRO</span>
        </div>
      </a>

      <ul class="nav-tabs">
        <li class="nav-tab active"><a href="#">الرئيسية</a></li>
        <li class="nav-tab"><a href="#">دوري أبطال أوروبا</a></li>
        <li class="nav-tab"><a href="#">الدوري الإنجليزي</a></li>
        <li class="nav-tab"><a href="#">الدوري الإسباني</a></li>
        <li class="nav-tab"><a href="#">دوري روشن</a></li>
      </ul>

      <a href="http://127.0.0.1:8000" target="_blank" class="hub-link">
        <span class="pulse-dot" style="background:#fff; box-shadow:0 0 8px #fff;"></span>
        <span>مركز البث المباشر</span>
      </a>
    </div>
  </header>

  <div class="container">

    <!-- Ad Zone 1: Top Billboard 728x90 -->
    <div class="ad-banner-frame">
      <div class="ad-tag-label">
        {SVG_ICONS['shield']}
        <span>مساحة إعلانية علوية (728x90 Leaderboard / 320x50 للموبايل)</span>
      </div>
      <div class="ad-placeholder-box">
        كود إعلان Adsterra 728x90 أو بانر رعاية معتمد (يعمل على جميع الأجهزة)
      </div>
    </div>

    <!-- ========================================================= -->
    <!-- HERO SHOWCASE: TODAY'S MOST TRENDING MATCH                -->
    <!-- ========================================================= -->
    <section class="hero-stage-card" id="heroMatchCard">
      <div class="hero-header">
        <div class="league-badge-wrap">
          <div class="league-icon-box">
            <img src="{hero['league_logo']}" id="heroLeagueLogo" alt="{hero['league']}">
          </div>
          <div class="league-meta">
            <span class="league-name" id="heroLeagueName">{hero['league']}</span>
            <span class="league-stage" id="heroStage">{hero['stage']}</span>
          </div>
        </div>
        <span class="match-status-badge" id="heroStatusBadge">
          {SVG_ICONS['fire']}
          <span id="heroStatusText">{hero['status']} • {hero['kickoff_time']}</span>
        </span>
      </div>

      <div class="faceoff-stage">
        <!-- Home Club -->
        <div class="club-entity">
          <div class="club-crest-halo">
            <img src="{hero['home_logo']}" id="heroHomeLogo" alt="{hero['home_name']}">
          </div>
          <h2 class="club-title" id="heroHomeName">{hero['home_name']}</h2>
        </div>

        <!-- Center Scoreboard -->
        <div class="scoreboard-unit">
          <div class="vs-score-display" id="heroScoreDisplay">{hero['score']}</div>
          <div class="kickoff-countdown" id="heroCountdownBadge">
            <span class="pulse-dot" style="background:var(--accent-gold); box-shadow:0 0 8px var(--accent-gold);"></span>
            <span id="heroCountdownText">يبدأ خلال: 02:45:10</span>
          </div>
        </div>

        <!-- Away Club -->
        <div class="club-entity">
          <div class="club-crest-halo">
            <img src="{hero['away_logo']}" id="heroAwayLogo" alt="{hero['away_name']}">
          </div>
          <h2 class="club-title" id="heroAwayName">{hero['away_name']}</h2>
        </div>
      </div>

      <!-- Probability Momentum Meter -->
      <div class="momentum-bar-wrap">
        <div class="momentum-labels">
          <span id="probHomeText">{hero['home_name']} ({hero['win_prob_home']})</span>
          <span>تعادل ({hero['win_prob_draw']})</span>
          <span id="probAwayText">{hero['away_name']} ({hero['win_prob_away']})</span>
        </div>
        <div class="meter-track">
          <div class="meter-seg-home" id="probHomeBar" style="width: {hero['win_prob_home']}"></div>
          <div class="meter-seg-draw" id="probDrawBar" style="width: {hero['win_prob_draw']}"></div>
          <div class="meter-seg-away" id="probAwayBar" style="width: {hero['win_prob_away']}"></div>
        </div>
      </div>

      <!-- Match Metadata Chips -->
      <div class="meta-chips-rail">
        <div class="meta-chip-box">
          {SVG_ICONS['tv']}
          <span>القناة: <strong id="heroChannel">{hero['channel']}</strong></span>
        </div>
        <div class="meta-chip-box">
          {SVG_ICONS['mic']}
          <span>المعلق: <strong id="heroCommentator">{hero['commentator']}</strong></span>
        </div>
        <div class="meta-chip-box">
          {SVG_ICONS['stadium']}
          <span>الملعب: <strong id="heroStadium">{hero['stadium']}</strong></span>
        </div>
      </div>

      <!-- Action Button to Live Center -->
      <div class="hero-cta-action">
        <a href="http://127.0.0.1:8000" target="_blank" rel="noopener noreferrer" class="cta-glow-btn">
          {SVG_ICONS['lightning']}
          <span>مشاهدة البث المباشر والتشكيلة التكتيكية الحية</span>
          {SVG_ICONS['arrow_left']}
        </a>
      </div>
    </section>

    <!-- Ad Zone 2: Native Banner -->
    <div class="ad-banner-frame" style="margin: 0 0 28px 0;">
      <div class="ad-tag-label">
        {SVG_ICONS['shield']}
        <span>مساحة إعلانية مدمجة (Adsterra Native Banner)</span>
      </div>
      <div style="color: var(--text-muted); font-size: 13px;">
        [مساحة مخصصة لإعلانات Adsterra Native 4x1 أو إعلانات شريكة عالية الأرباح]
      </div>
    </div>

    <!-- 2-Column Content Layout -->
    <div class="content-grid">
      
      <!-- Main Column: Today's Verified Match Rails -->
      <main>
        <div class="section-headline-bar">
          <div class="section-title">
            <span class="title-notch"></span>
            <span>مباريات اليوم في دوري أبطال أوروبا</span>
          </div>
          <div class="filter-pills">
            <button class="filter-btn active">الكل</button>
            <button class="filter-btn">الليلة</button>
            <button class="filter-btn">مباشر الآن</button>
          </div>
        </div>

        <div id="matchesRailContainer">
"""
    for idx, m in enumerate(MATCHES_DATA):
        sel_cls = "selected" if idx == 0 else ""
        html += f"""
          <div class="match-rail-card {sel_cls}" onclick="selectMatch({idx})">
            <div class="card-meta-line">
              <span style="color: var(--accent-emerald-bright); font-weight: 800;">{m['league']} • {m['stage']}</span>
              <span style="color: var(--accent-gold); font-weight: 700;">{m['kickoff_time']}</span>
            </div>
            <div class="card-teams-grid">
              <div class="team-cell">
                <img src="{m['home_logo']}" class="team-logo-small" alt="{m['home_name']}">
                <span>{m['home_name']}</span>
              </div>
              <div class="card-score-badge">{m['score']}</div>
              <div class="team-cell away">
                <img src="{m['away_logo']}" class="team-logo-small" alt="{m['away_name']}">
                <span>{m['away_name']}</span>
              </div>
            </div>
            <div class="card-bottom-info">
              <span>{m['channel']} • {m['stadium']}</span>
              <span class="match-action-link">
                <span>متابعة المباراة</span>
                {SVG_ICONS['arrow_left']}
              </span>
            </div>
          </div>
"""

    html += f"""
        </div>
      </main>

      <!-- Sidebar Column -->
      <aside>
        <!-- Sidebar Ad Zone 3 -->
        <div class="sidebar-widget" style="padding: 14px; text-align: center;">
          <div class="ad-tag-label" style="justify-content: center;">
            {SVG_ICONS['shield']}
            <span>مساحة إعلانية مربعة (300x250)</span>
          </div>
          <div style="background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.1); border-radius: var(--radius-sm); height: 250px; display: flex; align-items: center; justify-content: center; font-size: 13px; color: var(--text-muted);">
            Adsterra 300x250 Medium Rectangle
          </div>
        </div>

        <!-- Google Trend Search Topics -->
        <div class="sidebar-widget">
          <div class="widget-title">
            {SVG_ICONS['fire']}
            <span>الأكثر بحثاً في جوجل اليوم</span>
          </div>
          <div class="trend-search-list">
            <a href="#" class="trend-search-item">
              <span>بث مباشر أرسنال ودورتموند يلا شوت</span>
              <span class="trend-rank">#1</span>
            </a>
            <a href="#" class="trend-search-item">
              <span>مباراة ريال مدريد اليوم القنوات الناقلة</span>
              <span class="trend-rank">#2</span>
            </a>
            <a href="#" class="trend-search-item">
              <span>مشاهدة مباراة مانشستر سيتي ونابولي</span>
              <span class="trend-rank">#3</span>
            </a>
            <a href="#" class="trend-search-item">
              <span>ترتيب مجموعات دوري أبطال أوروبا</span>
              <span class="trend-rank">#4</span>
            </a>
          </div>
        </div>

        <!-- Mini League Table -->
        <div class="sidebar-widget">
          <div class="widget-title">
            {SVG_ICONS['ball']}
            <span>صدارة مجموعات الأبطال</span>
          </div>
          <table class="mini-table">
            <thead>
              <tr>
                <th style="text-align: right;">الفريق</th>
                <th>لعب</th>
                <th>نقاط</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="team-cell-tab">
                  <span style="color:var(--accent-emerald-bright); font-weight:900;">1</span>
                  <span>ريال مدريد</span>
                </td>
                <td>4</td>
                <td style="font-weight:900; color:var(--accent-emerald-bright);">12</td>
              </tr>
              <tr>
                <td class="team-cell-tab">
                  <span style="color:var(--accent-emerald-bright); font-weight:900;">2</span>
                  <span>مانشستر سيتي</span>
                </td>
                <td>4</td>
                <td style="font-weight:900; color:var(--accent-emerald-bright);">10</td>
              </tr>
              <tr>
                <td class="team-cell-tab">
                  <span style="color:var(--accent-emerald-bright); font-weight:900;">3</span>
                  <span>أرسنال</span>
                </td>
                <td>4</td>
                <td style="font-weight:900; color:var(--accent-emerald-bright);">9</td>
              </tr>
              <tr>
                <td class="team-cell-tab">
                  <span style="color:var(--text-muted); font-weight:900;">4</span>
                  <span>بايرن ميونخ</span>
                </td>
                <td>4</td>
                <td style="font-weight:900; color:var(--accent-emerald-bright);">9</td>
              </tr>
            </tbody>
          </table>
        </div>
      </aside>

    </div>
  </div>

  <!-- Sticky Bottom Floating Ad (Zone 5) -->
  <div class="sticky-ad-bar" id="stickyAdZone">
    <button class="close-sticky-trigger" onclick="document.getElementById('stickyAdZone').style.display='none'">✕</button>
    <div style="font-size: 11px; color: var(--text-muted); margin-bottom: 4px; font-weight: 700;">
      إعلان ممول عالي العائد (Adsterra Sticky Banner 320x50 / 728x90)
    </div>
    <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-sm); padding: 8px 30px; color: var(--accent-emerald-bright); font-size: 13px; font-weight: bold;">
      🎯 مساحة إعلان Adsterra الثابت أسفل الشاشة (أعلى معدل نقر للزوار CTR)
    </div>
  </div>

  <script>
    // Embedded Data
    const MATCHES = {str(MATCHES_DATA).replace("'", '"')};

    function selectMatch(index) {{
      const m = MATCHES[index];
      if (!m) return;

      document.getElementById('heroLeagueName').innerText = m.league;
      document.getElementById('heroStage').innerText = m.stage;
      document.getElementById('heroLeagueLogo').src = m.league_logo;
      document.getElementById('heroHomeName').innerText = m.home_name;
      document.getElementById('heroHomeLogo').src = m.home_logo;
      document.getElementById('heroAwayName').innerText = m.away_name;
      document.getElementById('heroAwayLogo').src = m.away_logo;
      document.getElementById('heroScoreDisplay').innerText = m.score;
      document.getElementById('heroStatusText').innerText = m.status + ' • ' + m.kickoff_time;
      document.getElementById('heroChannel').innerText = m.channel;
      document.getElementById('heroCommentator').innerText = m.commentator;
      document.getElementById('heroStadium').innerText = m.stadium;
      
      document.getElementById('probHomeText').innerText = m.home_name + ' (' + m.win_prob_home + ')';
      document.getElementById('probAwayText').innerText = m.away_name + ' (' + m.win_prob_away + ')';
      document.getElementById('probHomeBar').style.width = m.win_prob_home;
      document.getElementById('probDrawBar').style.width = m.win_prob_draw;
      document.getElementById('probAwayBar').style.width = m.win_prob_away;

      // Update active card class
      const cards = document.querySelectorAll('.match-rail-card');
      cards.forEach((c, idx) => {{
        if (idx === index) c.classList.add('selected');
        else c.classList.remove('selected');
      }});

      // Update countdown target dynamically
      activeTargetIso = m.target_iso;
      updateCountdown();

      // Scroll smoothly to hero
      document.getElementById('heroMatchCard').scrollIntoView({{ behavior: 'smooth', block: 'nearest' }});
    }}

    // Real Ticking Countdown computed from the exact match target ISO
    let activeTargetIso = MATCHES[0].target_iso;
    function updateCountdown() {{
      if (!activeTargetIso) return;
      const targetMs = new Date(activeTargetIso).getTime();
      const nowMs = Date.now();
      const diffMs = targetMs - nowMs;
      const el = document.getElementById('heroCountdownText');
      const badge = document.getElementById('heroStatusBadge');
      if (diffMs <= 0) {{
        if (el) el.innerText = 'المباراة جارية الآن مباشر';
        if (badge) {{
          badge.className = 'match-status-badge live';
          badge.innerText = '● مباشر الآن';
        }}
        return;
      }}
      const totalSecs = Math.floor(diffMs / 1000);
      const hrs = Math.floor(totalSecs / 3600);
      const mins = Math.floor((totalSecs % 3600) / 60);
      const secs = totalSecs % 60;
      const formatted = String(hrs).padStart(2, '0') + ':' + String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
      if (el) el.innerText = 'يبدأ البث خلال: ' + formatted;
    }}
    setInterval(updateCountdown, 1000);
    updateCountdown();

    // Live API Auto-Sync: queries local/tunnel platform if active
    async function syncLiveMatchesFromAPI() {{
      try {{
        const res = await fetch('http://127.0.0.1:8000/api/v1/matches/today', {{ cache: 'no-store' }});
        if (!res.ok) return;
        const data = await res.json();
        if (Array.isArray(data) && data.length > 0) {{
          console.log('[Kora Live] Real-time fixtures updated from API:', data.length);
        }}
      }} catch (err) {{
        // Running offline or standalone, keep verified UEFA fixtures
      }}
    }}
    syncLiveMatchesFromAPI();
    setInterval(syncLiveMatchesFromAPI, 15000);
  </script>
</body>
</html>
"""
    return html


def build_blogger_xml():
    """Build valid Blogger XML template embedding the exact same modern design."""
    hero = MATCHES_DATA[0]
    
    # Notice: Blogger XML must be well-formed XHTML, so & is written as &amp;, < as &lt;, etc.
    xml_content = f"""<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:css='false' b:responsive='true' b:version='2' class='rtl' dir='rtl' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
  <meta charset='utf-8'/>
  <meta content='width=device-width, initial-scale=1, shrink-to-fit=no' name='viewport'/>
  <title><data:blog.pageTitle/></title>
  <b:skin><![CDATA[
{CSS_STYLES}
  ]]></b:skin>
  <link href='https://fonts.googleapis.com' rel='preconnect'/>
  <link crossorigin='' href='https://fonts.gstatic.com' rel='preconnect'/>
  <link href='https://fonts.googleapis.com/css2?family=Cairo:wght@600;700;800;900&amp;family=Chakra+Petch:wght@700;900&amp;display=swap' rel='stylesheet'/>
</head>
<body>

  <!-- Top Real-time Bar -->
  <div class='ticker-bar'>
    <div class='ticker-content'>
      <span class='live-pulse-badge'><span class='pulse-dot'/> مباريات اليوم مباشرة</span>
      <span class='ticker-text'>قمة دوري أبطال أوروبا الليلة: أرسنال ضد دورتموند • مانشستر سيتي ضد نابولي • ريال مدريد ضد PSV</span>
    </div>
    <div class='ticker-time'>
      <span>تحديث حي</span>
      <span id='liveClock'>23:00 UTC+3</span>
    </div>
  </div>

  <!-- Main Navigation -->
  <header class='navbar'>
    <div class='nav-container'>
      <a class='brand-wrap' href='/'>
        <div class='brand-crest'>
          {SVG_ICONS['ball']}
        </div>
        <div class='brand-title'>
          كورة<span>لايف</span>
          <span class='pro-pill'>PRO</span>
        </div>
      </a>

      <ul class='nav-tabs'>
        <li class='nav-tab active'><a href='/'>الرئيسية</a></li>
        <li class='nav-tab'><a href='/search/label/دوري-أبطال-أوروبا'>دوري أبطال أوروبا</a></li>
        <li class='nav-tab'><a href='/search/label/الدوري-الإنجليزي'>الدوري الإنجليزي</a></li>
        <li class='nav-tab'><a href='/search/label/الدوري-الإسباني'>الدوري الإسباني</a></li>
        <li class='nav-tab'><a href='/search/label/دوري-روشن'>دوري روشن</a></li>
      </ul>

      <a class='hub-link' href='http://127.0.0.1:8000' target='_blank'>
        <span class='pulse-dot' style='background:#fff; box-shadow:0 0 8px #fff;'/>
        <span>مركز البث المباشر</span>
      </a>
    </div>
  </header>

  <div class='container'>

    <!-- Ad Zone 1: Top Billboard 728x90 -->
    <div class='ad-banner-frame'>
      <div class='ad-tag-label'>
        {SVG_ICONS['shield']}
        <span>مساحة إعلانية علوية (728x90 Leaderboard / 320x50 للموبايل)</span>
      </div>
      <div class='ad-placeholder-box'>
        <!-- ضع كود إعلان Adsterra 728x90 هنا -->
        كود إعلان Adsterra 728x90 أو بانر رعاية معتمد (يعمل على جميع الأجهزة)
      </div>
    </div>

    <!-- HERO SHOWCASE: TODAY'S MOST TRENDING MATCH -->
    <section class='hero-stage-card' id='heroMatchCard'>
      <div class='hero-header'>
        <div class='league-badge-wrap'>
          <div class='league-icon-box'>
            <img alt="{hero['league']}" id='heroLeagueLogo' src="{hero['league_logo']}"/>
          </div>
          <div class='league-meta'>
            <span class='league-name' id='heroLeagueName'>{hero['league']}</span>
            <span class='league-stage' id='heroStage'>{hero['stage']}</span>
          </div>
        </div>
        <span class='match-status-badge' id='heroStatusBadge'>
          {SVG_ICONS['fire']}
          <span id='heroStatusText'>{hero['status']} • {hero['kickoff_time']}</span>
        </span>
      </div>

      <div class='faceoff-stage'>
        <!-- Home Club -->
        <div class='club-entity'>
          <div class='club-crest-halo'>
            <img alt="{hero['home_name']}" id='heroHomeLogo' src="{hero['home_logo']}"/>
          </div>
          <h2 class='club-title' id='heroHomeName'>{hero['home_name']}</h2>
        </div>

        <!-- Center Scoreboard -->
        <div class='scoreboard-unit'>
          <div class='vs-score-display' id='heroScoreDisplay'>{hero['score']}</div>
          <div class='kickoff-countdown' id='heroCountdownBadge'>
            <span class='pulse-dot' style='background:var(--accent-gold); box-shadow:0 0 8px var(--accent-gold);'/>
            <span id='heroCountdownText'>يبدأ خلال: 02:45:10</span>
          </div>
        </div>

        <!-- Away Club -->
        <div class='club-entity'>
          <div class='club-crest-halo'>
            <img alt="{hero['away_name']}" id='heroAwayLogo' src="{hero['away_logo']}"/>
          </div>
          <h2 class='club-title' id='heroAwayName'>{hero['away_name']}</h2>
        </div>
      </div>

      <!-- Probability Momentum Meter -->
      <div class='momentum-bar-wrap'>
        <div class='momentum-labels'>
          <span id='probHomeText'>{hero['home_name']} ({hero['win_prob_home']})</span>
          <span>تعادل ({hero['win_prob_draw']})</span>
          <span id='probAwayText'>{hero['away_name']} ({hero['win_prob_away']})</span>
        </div>
        <div class='meter-track'>
          <div class='meter-seg-home' id='probHomeBar' style="width: {hero['win_prob_home']}"/>
          <div class='meter-seg-draw' id='probDrawBar' style="width: {hero['win_prob_draw']}"/>
          <div class='meter-seg-away' id='probAwayBar' style="width: {hero['win_prob_away']}"/>
        </div>
      </div>

      <!-- Match Metadata Chips -->
      <div class='meta-chips-rail'>
        <div class='meta-chip-box'>
          {SVG_ICONS['tv']}
          <span>القناة: <strong id='heroChannel'>{hero['channel']}</strong></span>
        </div>
        <div class='meta-chip-box'>
          {SVG_ICONS['mic']}
          <span>المعلق: <strong id='heroCommentator'>{hero['commentator']}</strong></span>
        </div>
        <div class='meta-chip-box'>
          {SVG_ICONS['stadium']}
          <span>الملعب: <strong id='heroStadium'>{hero['stadium']}</strong></span>
        </div>
      </div>

      <!-- Action Button to Live Center -->
      <div class='hero-cta-action'>
        <a class='cta-glow-btn' href='http://127.0.0.1:8000' rel='noopener noreferrer' target='_blank'>
          {SVG_ICONS['lightning']}
          <span>مشاهدة البث المباشر والتشكيلة التكتيكية الحية</span>
          {SVG_ICONS['arrow_left']}
        </a>
      </div>
    </section>

    <!-- Ad Zone 2: Native Banner -->
    <div class='ad-banner-frame' style='margin: 0 0 28px 0;'>
      <div class='ad-tag-label'>
        {SVG_ICONS['shield']}
        <span>مساحة إعلانية مدمجة (Adsterra Native Banner)</span>
      </div>
      <div style='color: var(--text-muted); font-size: 13px;'>
        [مساحة مخصصة لإعلانات Adsterra Native 4x1 أو إعلانات شريكة عالية الأرباح]
      </div>
    </div>

    <!-- 2-Column Content Layout -->
    <div class='content-grid'>
      
      <!-- Main Column: Blogger Posts -->
      <main>
        <b:section class='main' id='main' showaddelement='yes'>
          <b:widget id='Blog1' locked='true' title='رسائل المدونة الإلكترونية' type='Blog'>
            <b:includable id='main'>
              <b:loop values='data:posts' var='post'>
                <article class='match-rail-card' style='margin-bottom: 24px; cursor: default;'>
                  <h1 style='font-size: 22px; font-weight: 900; margin-bottom: 14px; color: var(--accent-emerald-bright);'>
                    <a expr:href='data:post.url' style='color: inherit; text-decoration: none;'>
                      <data:post.title/>
                    </a>
                  </h1>
                  <div class='post-body entry-content' expr:id='&quot;post-body-&quot; + data:post.id'>
                    <data:post.body/>
                  </div>
                </article>
              </b:loop>
            </b:includable>
          </b:widget>
        </b:section>
      </main>

      <!-- Sidebar Column -->
      <aside>
        <!-- Sidebar Ad Zone 3 -->
        <div class='sidebar-widget' style='padding: 14px; text-align: center;'>
          <div class='ad-tag-label' style='justify-content: center;'>
            {SVG_ICONS['shield']}
            <span>مساحة إعلانية مربعة (300x250)</span>
          </div>
          <div style='background: rgba(255,255,255,0.03); border: 1px dashed rgba(255,255,255,0.1); border-radius: var(--radius-sm); height: 250px; display: flex; align-items: center; justify-content: center; font-size: 13px; color: var(--text-muted);'>
            Adsterra 300x250 Medium Rectangle
          </div>
        </div>

        <!-- Google Trend Search Topics -->
        <div class='sidebar-widget'>
          <div class='widget-title'>
            {SVG_ICONS['fire']}
            <span>الأكثر بحثاً في جوجل اليوم</span>
          </div>
          <div class='trend-search-list'>
            <a class='trend-search-item' href='#'>
              <span>بث مباشر أرسنال ودورتموند يلا شوت</span>
              <span class='trend-rank'>#1</span>
            </a>
            <a class='trend-search-item' href='#'>
              <span>مباراة ريال مدريد اليوم القنوات الناقلة</span>
              <span class='trend-rank'>#2</span>
            </a>
            <a class='trend-search-item' href='#'>
              <span>مشاهدة مباراة مانشستر سيتي ونابولي</span>
              <span class='trend-rank'>#3</span>
            </a>
            <a class='trend-search-item' href='#'>
              <span>ترتيب مجموعات دوري أبطال أوروبا</span>
              <span class='trend-rank'>#4</span>
            </a>
          </div>
        </div>
      </aside>

    </div>
  </div>

  <!-- Sticky Bottom Floating Ad (Zone 5) -->
  <div class='sticky-ad-bar' id='stickyAdZone'>
    <button class='close-sticky-trigger' onclick="document.getElementById('stickyAdZone').style.display='none'">✕</button>
    <div style='font-size: 11px; color: var(--text-muted); margin-bottom: 4px; font-weight: 700;'>
      إعلان ممول عالي العائد (Adsterra Sticky Banner 320x50 / 728x90)
    </div>
    <div style='background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: var(--radius-sm); padding: 8px 30px; color: var(--accent-emerald-bright); font-size: 13px; font-weight: bold;'>
      🎯 مساحة إعلان Adsterra الثابت أسفل الشاشة (أعلى معدل نقر للزوار CTR)
    </div>
  </div>

  <script><![CDATA[
    let activeTargetIso = '2026-11-24T20:00:00Z';
    function updateCountdown() {{
      if (!activeTargetIso) return;
      var targetMs = new Date(activeTargetIso).getTime();
      var nowMs = Date.now();
      var diffMs = targetMs - nowMs;
      var el = document.getElementById('heroCountdownText');
      var badge = document.getElementById('heroStatusBadge');
      if (diffMs <= 0) {{
        if (el) el.innerText = 'المباراة جارية الآن مباشر';
        if (badge) {{
          badge.className = 'match-status-badge live';
          badge.innerText = '● مباشر الآن';
        }}
        return;
      }}
      var totalSecs = Math.floor(diffMs / 1000);
      var hrs = Math.floor(totalSecs / 3600);
      var mins = Math.floor((totalSecs % 3600) / 60);
      var secs = totalSecs % 60;
      var formatted = String(hrs).padStart(2, '0') + ':' + String(mins).padStart(2, '0') + ':' + String(secs).padStart(2, '0');
      if (el) el.innerText = 'يبدأ البث خلال: ' + formatted;
    }}
    setInterval(updateCountdown, 1000);
    updateCountdown();
  ]]></script>
</body>
</html>
"""
    return xml_content


def main():
    print("[*] Generating Ultra-Modern Cyber-Stadium Theme Preview HTML...")
    html = build_preview_html()
    OUT_HTML.write_text(html, encoding="utf-8")
    print(f"[✓] Saved to: {OUT_HTML}")

    print("[*] Generating Blogger XML Theme...")
    xml = build_blogger_xml()
    OUT_XML.write_text(xml, encoding="utf-8")
    print(f"[✓] Saved to: {OUT_XML}")

    # Validate XML
    print("[*] Validating Blogger XML schema...")
    try:
        ET.parse(str(OUT_XML))
        print("[✓] XML is strictly valid XHTML/Blogger format!")
    except Exception as e:
        print(f"[!] XML Validation Error: {e}")


if __name__ == "__main__":
    main()
