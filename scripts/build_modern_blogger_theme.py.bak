# -*- coding: utf-8 -*-
"""Generate Ultra-Modern Cyber-Stadium Theme Preview and Blogger XML."""

from pathlib import Path
import xml.etree.ElementTree as ET

ROOT = Path(r"C:\Users\Mohany\Desktop\football-live-score-platform")
OUT_HTML = ROOT / "blogger_theme" / "theme_preview.html"
OUT_XML = ROOT / "blogger_theme" / "kora_pro_blogger_theme.xml"

# CSS & Shared Assets
CSS_STYLES = """
    :root {
      --bg-void: #050811;
      --bg-surface: #0a0f1d;
      --bg-surface-elevated: #0f172a;
      --bg-glass: rgba(15, 23, 42, 0.75);
      --bg-glass-card: rgba(18, 27, 49, 0.65);
      
      --accent-emerald: #10b981;
      --accent-emerald-bright: #34d399;
      --accent-emerald-glow: rgba(16, 185, 129, 0.3);
      --accent-cyan: #06b6d4;
      --accent-cyan-glow: rgba(6, 182, 212, 0.25);
      --accent-gold: #f59e0b;
      --accent-red: #ef4444;
      
      --text-white: #f8fafc;
      --text-silver: #cbd5e1;
      --text-muted: #64748b;
      --text-dim: #475569;
      
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-glass: rgba(255, 255, 255, 0.12);
      --border-accent: rgba(16, 185, 129, 0.35);
      
      --font-display: 'Cairo', system-ui, -apple-system, sans-serif;
      --font-mono: 'Chakra Petch', 'JetBrains Mono', monospace;
      
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-xl: 28px;
      
      --shadow-card: 0 10px 30px -5px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.06);
      --shadow-glow: 0 0 40px -10px rgba(16, 185, 129, 0.3);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    body {
      background-color: var(--bg-void);
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(16, 185, 129, 0.12) 0%, transparent 60%),
        radial-gradient(circle at 10% 20%, rgba(6, 182, 212, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 90% 40%, rgba(16, 185, 129, 0.06) 0%, transparent 45%);
      background-attachment: fixed;
      color: var(--text-white);
      font-family: var(--font-display);
      direction: rtl;
      text-align: right;
      line-height: 1.6;
      min-height: 100vh;
      overflow-x: hidden;
      padding-bottom: 90px;
    }

    /* Live Ticker Bar */
    .ticker-bar {
      background: rgba(6, 11, 22, 0.95);
      border-bottom: 1px solid var(--border-subtle);
      padding: 8px 24px;
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      backdrop-filter: blur(12px);
      position: relative;
      z-index: 50;
    }
    .ticker-content {
      display: flex;
      align-items: center;
      gap: 12px;
      overflow: hidden;
    }
    .live-pulse-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(239, 68, 68, 0.15);
      border: 1px solid rgba(239, 68, 68, 0.4);
      color: #fca5a5;
      padding: 2px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.5px;
      flex-shrink: 0;
    }
    .pulse-dot {
      width: 7px;
      height: 7px;
      background: var(--accent-red);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--accent-red);
      animation: pulseAnim 1.6s infinite;
    }
    @keyframes pulseAnim {
      0% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(1.3); }
      100% { opacity: 1; transform: scale(1); }
    }
    .ticker-text {
      color: var(--text-silver);
      font-weight: 600;
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .ticker-time {
      font-family: var(--font-mono);
      color: var(--accent-gold);
      font-size: 12px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Navbar */
    .navbar {
      background: rgba(10, 15, 29, 0.85);
      backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      position: sticky;
      top: 0;
      z-index: 40;
    }
    .nav-container {
      max-width: 1280px;
      margin: 0 auto;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .brand-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: var(--text-white);
    }
    .brand-crest {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, #10b981 0%, #06b6d4 100%);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 16px var(--accent-emerald-glow);
    }
    .brand-title {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: -0.5px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .brand-title span {
      color: var(--accent-emerald-bright);
    }
    .pro-pill {
      font-size: 10px;
      font-weight: 900;
      color: var(--accent-cyan);
      border: 1px solid rgba(6, 182, 212, 0.4);
      background: rgba(6, 182, 212, 0.1);
      padding: 1px 7px;
      border-radius: 8px;
    }
    .nav-tabs {
      display: flex;
      align-items: center;
      gap: 6px;
      list-style: none;
    }
    .nav-tab a {
      color: var(--text-silver);
      text-decoration: none;
      font-size: 14px;
      font-weight: 700;
      padding: 8px 16px;
      border-radius: var(--radius-sm);
      transition: all 0.2s;
    }
    .nav-tab a:hover, .nav-tab.active a {
      color: var(--text-white);
      background: rgba(255, 255, 255, 0.08);
    }
    .nav-tab.active a {
      background: rgba(16, 185, 129, 0.15);
      color: var(--accent-emerald-bright);
      border: 1px solid rgba(16, 185, 129, 0.3);
    }
    .hub-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      text-decoration: none;
      font-weight: 800;
      font-size: 13px;
      padding: 9px 20px;
      border-radius: var(--radius-sm);
      box-shadow: 0 4px 18px var(--accent-emerald-glow);
      transition: all 0.2s;
    }
    .hub-link:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 24px rgba(16, 185, 129, 0.5);
    }

    /* Page Layout */
    .container {
      max-width: 1280px;
      margin: 24px auto;
      padding: 0 24px;
    }

    /* Ad Container Zone */
    .ad-banner-frame {
      background: var(--bg-glass-card);
      border: 1px dashed rgba(255, 255, 255, 0.14);
      border-radius: var(--radius-md);
      padding: 16px;
      text-align: center;
      margin: 20px 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(10px);
      transition: border-color 0.2s;
    }
    .ad-banner-frame:hover {
      border-color: var(--border-accent);
    }
    .ad-tag-label {
      font-size: 11px;
      color: var(--text-muted);
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .ad-placeholder-box {
      width: 100%;
      max-width: 728px;
      min-height: 90px;
      background: rgba(16, 185, 129, 0.05);
      border: 1px solid rgba(16, 185, 129, 0.2);
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--accent-emerald-bright);
      font-size: 13px;
      font-weight: 700;
      padding: 12px;
    }

    /* ========================================================= */
    /* HERO TRENDING MATCH OF THE DAY (THE SHOWCASE CARD)        */
    /* ========================================================= */
    .hero-stage-card {
      background: linear-gradient(145deg, #0d1527 0%, #060a15 100%);
      border: 1px solid var(--border-accent);
      border-radius: var(--radius-xl);
      padding: 36px 32px;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-card), var(--shadow-glow);
      margin-bottom: 36px;
    }
    .hero-stage-card::before {
      content: '';
      position: absolute;
      top: -30%;
      left: 15%;
      width: 70%;
      height: 90%;
      background: radial-gradient(ellipse at center, rgba(16, 185, 129, 0.15) 0%, rgba(6, 182, 212, 0.05) 50%, transparent 75%);
      pointer-events: none;
    }
    .hero-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 18px;
      margin-bottom: 28px;
      position: relative;
      z-index: 2;
    }
    .league-badge-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
    }
    .league-icon-box {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 4px;
    }
    .league-icon-box img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .league-meta {
      display: flex;
      flex-direction: column;
    }
    .league-name {
      font-size: 15px;
      font-weight: 800;
      color: var(--text-white);
    }
    .league-stage {
      font-size: 12px;
      color: var(--text-muted);
    }
    .match-status-badge {
      font-size: 12px;
      font-weight: 800;
      padding: 5px 16px;
      border-radius: 20px;
      letter-spacing: 0.5px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(16, 185, 129, 0.15);
      color: var(--accent-emerald-bright);
      border: 1px solid rgba(16, 185, 129, 0.4);
    }
    .match-status-badge.live {
      background: rgba(239, 68, 68, 0.15);
      color: #fca5a5;
      border-color: rgba(239, 68, 68, 0.5);
    }

    /* Faceoff Center Stage */
    .faceoff-stage {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 24px;
      text-align: center;
      position: relative;
      z-index: 2;
      margin: 16px 0;
    }
    .club-entity {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 14px;
    }
    .club-crest-halo {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: radial-gradient(circle, #1a243a 0%, #0d1424 100%);
      border: 2px solid rgba(255, 255, 255, 0.14);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.7);
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s;
    }
    .club-entity:hover .club-crest-halo {
      transform: scale(1.08);
      border-color: var(--accent-emerald-bright);
      box-shadow: 0 16px 40px var(--accent-emerald-glow);
    }
    .club-crest-halo img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
    .club-title {
      font-size: 24px;
      font-weight: 900;
      color: var(--text-white);
      letter-spacing: -0.5px;
    }

    /* Digital Monospace Scoreboard */
    .scoreboard-unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }
    .vs-score-display {
      font-family: var(--font-mono);
      font-size: 44px;
      font-weight: 900;
      color: #ffffff;
      background: #060a15;
      border: 1px solid var(--border-glass);
      padding: 8px 36px;
      border-radius: 20px;
      letter-spacing: 6px;
      box-shadow: inset 0 2px 14px rgba(0, 0, 0, 0.8), 0 4px 20px rgba(0, 0, 0, 0.4);
      min-width: 180px;
      text-align: center;
    }
    .kickoff-countdown {
      font-family: var(--font-mono);
      font-size: 13px;
      font-weight: 700;
      color: var(--accent-gold);
      background: rgba(245, 158, 11, 0.1);
      border: 1px solid rgba(245, 158, 11, 0.3);
      padding: 4px 14px;
      border-radius: 20px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* Win Probability Meter */
    .momentum-bar-wrap {
      max-width: 540px;
      margin: 22px auto 0;
      position: relative;
      z-index: 2;
    }
    .momentum-labels {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      margin-bottom: 6px;
    }
    .meter-track {
      height: 6px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: 6px;
      overflow: hidden;
      display: flex;
    }
    .meter-seg-home {
      width: 52%;
      background: linear-gradient(90deg, #10b981 0%, #34d399 100%);
    }
    .meter-seg-draw {
      width: 24%;
      background: #475569;
    }
    .meter-seg-away {
      width: 24%;
      background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 100%);
    }

    /* Meta Chips (Channel, Commentator, Stadium) */
    .meta-chips-rail {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 24px;
      position: relative;
      z-index: 2;
    }
    .meta-chip-box {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--border-subtle);
      padding: 7px 18px;
      border-radius: 24px;
      font-size: 13px;
      color: var(--text-silver);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .meta-chip-box svg {
      width: 15px;
      height: 15px;
      color: var(--accent-emerald-bright);
      flex-shrink: 0;
    }
    .meta-chip-box strong {
      color: var(--text-white);
      font-weight: 700;
    }

    /* Big Hero Action Button */
    .hero-cta-action {
      margin-top: 28px;
      text-align: center;
      position: relative;
      z-index: 2;
    }
    .cta-glow-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      text-decoration: none;
      font-size: 16px;
      font-weight: 900;
      padding: 16px 48px;
      border-radius: var(--radius-md);
      box-shadow: 0 6px 30px rgba(16, 185, 129, 0.45);
      transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .cta-glow-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 10px 40px rgba(16, 185, 129, 0.65);
    }
    .cta-glow-btn svg {
      width: 18px;
      height: 18px;
      transition: transform 0.2s;
    }
    .cta-glow-btn:hover svg {
      transform: translateX(-4px);
    }

    /* ========================================================= */
    /* 2-COLUMN MAIN CONTENT GRID                                */
    /* ========================================================= */
    .content-grid {
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 32px;
    }

    /* Today's Fixtures Rail */
    .section-headline-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .section-title {
      font-size: 20px;
      font-weight: 900;
      color: var(--text-white);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .title-notch {
      width: 4px;
      height: 22px;
      background: var(--accent-emerald-bright);
      border-radius: 2px;
    }
    .filter-pills {
      display: flex;
      gap: 8px;
    }
    .filter-btn {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--text-silver);
      padding: 4px 14px;
      border-radius: 14px;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s;
    }
    .filter-btn.active, .filter-btn:hover {
      background: rgba(16, 185, 129, 0.2);
      border-color: var(--border-accent);
      color: var(--accent-emerald-bright);
    }

    /* Modern Matchday Cards */
    .match-rail-card {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 18px 22px;
      margin-bottom: 14px;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
      position: relative;
    }
    .match-rail-card:hover {
      background: var(--bg-surface-elevated);
      border-color: var(--border-accent);
      transform: translateX(-4px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.4);
    }
    .match-rail-card.selected {
      border-color: var(--accent-emerald-bright);
      background: rgba(16, 185, 129, 0.06);
    }
    .card-meta-line {
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 12px;
    }
    .card-teams-grid {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 16px;
    }
    .team-cell {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 15px;
      font-weight: 800;
      color: var(--text-white);
    }
    .team-cell.away {
      flex-direction: row-reverse;
      text-align: left;
    }
    .team-logo-small {
      width: 32px;
      height: 32px;
      object-fit: contain;
      filter: drop-shadow(0 2px 6px rgba(0,0,0,0.5));
    }
    .card-score-badge {
      font-family: var(--font-mono);
      font-size: 16px;
      font-weight: 900;
      background: #050811;
      border: 1px solid var(--border-subtle);
      padding: 4px 14px;
      border-radius: 8px;
      color: var(--accent-emerald-bright);
      letter-spacing: 2px;
      text-align: center;
      min-width: 60px;
    }
    .card-bottom-info {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 12px;
      padding-top: 10px;
      border-top: 1px solid var(--border-subtle);
      font-size: 12px;
      color: var(--text-muted);
    }
    .match-action-link {
      color: var(--accent-emerald-bright);
      font-weight: 800;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    /* Sidebar Widgets */
    .sidebar-widget {
      background: var(--bg-surface);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 22px;
      margin-bottom: 24px;
      box-shadow: var(--shadow-card);
    }
    .widget-title {
      font-size: 16px;
      font-weight: 900;
      color: var(--text-white);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
      border-right: 3px solid var(--accent-emerald);
      padding-right: 10px;
    }
    .trend-search-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .trend-search-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: rgba(255, 255, 255, 0.03);
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-size: 13px;
      font-weight: 700;
      color: var(--text-silver);
      text-decoration: none;
      transition: all 0.2s;
    }
    .trend-search-item:hover {
      background: rgba(16, 185, 129, 0.1);
      color: var(--text-white);
      transform: translateX(-3px);
    }
    .trend-rank {
      font-family: var(--font-mono);
      font-weight: 900;
      color: var(--accent-emerald);
    }

    /* Standings Table Widget */
    .mini-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    .mini-table th {
      color: var(--text-muted);
      font-weight: 700;
      padding: 6px 8px;
      text-align: center;
      border-bottom: 1px solid var(--border-subtle);
    }
    .mini-table td {
      padding: 8px 6px;
      border-bottom: 1px solid var(--border-subtle);
      text-align: center;
    }
    .mini-table td.team-cell-tab {
      text-align: right;
      font-weight: 800;
      color: var(--text-white);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Sticky Bottom Adsterra Bar */
    .sticky-ad-bar {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(10, 15, 29, 0.96);
      backdrop-filter: blur(16px);
      border-top: 1px solid var(--border-accent);
      padding: 10px;
      z-index: 999;
      display: flex;
      flex-direction: column;
      align-items: center;
      box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.7);
    }
    .close-sticky-trigger {
      position: absolute;
      top: -12px;
      right: 24px;
      background: var(--accent-red);
      color: white;
      border: none;
      width: 24px;
      height: 24px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 13px;
      font-weight: bold;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.5);
    }

    /* Responsive */
    @media (max-width: 900px) {
      .content-grid { grid-template-columns: 1fr; }
      .nav-tabs { display: none; }
      .faceoff-stage { gap: 12px; }
      .club-crest-halo { width: 72px; height: 72px; padding: 12px; }
      .club-title { font-size: 18px; }
      .vs-score-display { font-size: 28px; padding: 6px 20px; min-width: 120px; }
      .hero-stage-card { padding: 24px 18px; }
    }
"""

